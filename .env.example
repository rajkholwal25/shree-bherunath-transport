# Supabase — get from Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-secret-key
SUPABASE_ANON_KEY=your-publishable-key

# Database — get from Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# Flask
SECRET_KEY=your-secret-key-for-sessions
FLASK_ENV=development

# Only this email gets admin role (no one can sign up as admin)
SUPERADMIN_EMAIL=rajkholwal25.2@gmail.com

# Optional: send password reset link by email (Resend free tier: 100 emails/day)
# Get API key at https://resend.com/api-keys — then reset link is emailed instead of shown on page
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=Shree Bherunath Transport <onboarding@resend.dev>
